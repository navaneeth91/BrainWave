# Copy this file to .env and fill in your own values.

# Clerk publishable key from your Clerk dashboard
# (matches the Clerk instance your deployed backend uses).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c3RyaWtpbmctcmFtLTQyLmNsZXJrLmFjY291bnRzLmRldiQ

# Your deployed backend URL (public HTTPS endpoint). Use the real URL;
# do NOT use localhost — the Android emulator can't reach your PC localhost.
# Emulator (local backend) : http://10.0.2.2:5000
# Deployed backend        : https://your-backend.example.com
EXPO_PUBLIC_BACKEND_URL=https://your-backend.example.com
